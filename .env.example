# Set in the process environment or a local gitignored .env (process values win).
UTFPR_USERNAME=
UTFPR_PASSWORD=
MOODLE_USERNAME=
MOODLE_PASSWORD=
# Optional existing Moodle web service token (never required).
MOODLE_TOKEN=
# Optional institution-authorized Gmail app password; never your Google password.
CAMPUS_MAIL_ADDRESS=
CAMPUS_MAIL_APP_PASSWORD=
# Optional local LLM server. External model access is disabled by default.
CAMPUS_LLM_URL=http://localhost:11434
